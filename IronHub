----------------------------------------------------
-- CONTROLLER HOOK ENGINE
----------------------------------------------------

local CachedController = nil

local function getController()
    if CachedController and type(CachedController) == "table" and rawget(CachedController, "SetInputDirection") then
        return CachedController
    end

    if getgc then
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table" and rawget(obj, "SetInputDirection") and rawget(obj, "HasBaseAttackStage") then
                CachedController = obj
                return obj
            end
        end
    end
    return nil
end

local function executeAction(actionName)
    local controller = getController()
    if controller then
        if rawget(controller, "PerformAction") or controller.PerformAction then
            pcall(function()
                controller:PerformAction(actionName)
            end)
            return true
        end
    end

    -- Fallback via direct Action Module execution
    local char = LocalPlayer.Character
    local actionScript = char and char:FindFirstChild("LocalControlMgr", true) and char.LocalControlMgr:FindFirstChild("Action") and char.LocalControlMgr.Action:FindFirstChild(actionName)
    if actionScript and actionScript:IsA("ModuleScript") then
        local success, mod = pcall(require, actionScript)
        if success and type(mod) == "table" and mod.Perform then
            pcall(function() mod.Perform(controller or {}) end)
            return true
        end
    end
    return false
end

----------------------------------------------------
-- HELPER FUNCTIONS: ENEMY & TARGET DETECTION
----------------------------------------------------

local function isBoss(npc)
    if not npc or not npc:FindFirstChild("HumanoidRootPart") then return false end
    
    local hrp = npc.HumanoidRootPart
    local localEnemy = hrp:FindFirstChild("LocalEnemyNpc")
    if localEnemy then
        if localEnemy:IsA("ValueBase") and tostring(localEnemy.Value):lower():find("boss") then
            return true
        end
    end

    if npc.Name:lower():find("boss") then return true end

    local hum = npc:FindFirstChildOfClass("Humanoid")
    if hum and hum.MaxHealth > 5000 then return true end

    return false
end

local function isAlive(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health > 0 then return true end
    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    return hrp ~= nil
end

local function getEnemies()
    local bosses, normals = {}, {}
    local enemyFolder = workspace:FindFirstChild("EnemyNpc")
    if enemyFolder then
        for _, npc in ipairs(enemyFolder:GetChildren()) do
            if isAlive(npc) then
                if isBoss(npc) then
                    table.insert(bosses, npc)
                else
                    table.insert(normals, npc)
                end
            end
        end
    end
    return bosses, normals
end

local function getDragonEggs()
    local eggs = {}
    local f1 = workspace:FindFirstChild("DragonEgg")
    local f2 = workspace:FindFirstChild("DragonEggs")
    
    local function collect(folder)
        if folder then
            if folder:IsA("Model") or folder:IsA("BasePart") then
                table.insert(eggs, folder)
            else
                for _, obj in ipairs(folder:GetChildren()) do
                    if isAlive(obj) or obj:IsA("BasePart") then
                        table.insert(eggs, obj)
                    end
                end
            end
        end
    end

    collect(f1)
    collect(f2)
    return eggs
end

local function getTreasureChests()
    local chests = {}
    local tFolder = workspace:FindFirstChild("TreasureChests")
    if tFolder then
        for _, round in ipairs(tFolder:GetChildren()) do
            for _, chest in ipairs(round:GetChildren()) do
                if chest:IsA("Model") or chest:IsA("BasePart") then
                    table.insert(chests, chest)
                end
            end
        end
    end
    return chests
end

local function getTargetPart(target)
    if not target then return nil end
    if target:IsA("Model") then
        return target.PrimaryPart or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChildWhichIsA("BasePart", true)
    elseif target:IsA("BasePart") then
        return target
    end
    return nil
end

local function getTargetByPriority()
    local bosses, normals = getEnemies()
    local eggs = getDragonEggs()
    local chests = getTreasureChests()

    for i = 1, 4 do
        local pType = Priority[i]
        if pType == "Boss" and AutoFarmDungeon and #bosses > 0 then
            return bosses[1], "Boss"
        elseif pType == "Normal Enemy NPC" and AutoFarmDungeon and #normals > 0 then
            return normals[1], "Normal"
        elseif pType == "Dragon Egg" and AutoDragonEgg and #eggs > 0 then
            return eggs[1], "Egg"
        elseif pType == "Treasure Chest" and AutoTreasureChest and #chests > 0 then
            return chests[1], "Chest"
        end
    end
    return nil, nil
end

local function checkForIncomingSkill(target)
    if not AutoDodge or not target then return false end
    local hrp = target:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:FindFirstChild("SkillVelocity") then
        return true
    end
    return false
end

