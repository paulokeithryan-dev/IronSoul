-- COMBAT LOOPS (M1 & SKILLS Q, E, R, C)
----------------------------------------------------

-- Auto M1 Loop (Requires AutoFarmDungeon to be true)
task.spawn(function()
    while true do
        if AutoFarmDungeon and AutoM1 then
            local target = getTargetByPriority()
            if target and not IsDodging then
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end
        task.wait(AutoM1Delay)
    end
end)

-- Auto Skill Loop (Skills: Q, E, R, C)
task.spawn(function()
    while true do
        if AutoFarmDungeon then
            local target = getTargetByPriority()
            if target and not IsDodging then
                local skillsToCast = {
                    {Key = Enum.KeyCode.Q, Enabled = AutoSkillQ},
                    {Key = Enum.KeyCode.E, Enabled = AutoSkillE},
                    {Key = Enum.KeyCode.R, Enabled = AutoSkillR},
                    {Key = Enum.KeyCode.C, Enabled = AutoSkillC},
                }

                local usedAnySkill = false

                for _, skill in ipairs(skillsToCast) do
                    if skill.Enabled and not IsDodging and AutoFarmDungeon then
                        VirtualInputManager:SendKeyEvent(true, skill.Key, false, game)
                        task.wait(0.05)
                        VirtualInputManager:SendKeyEvent(false, skill.Key, false, game)
                        task.wait(0.15)
                        usedAnySkill = true
                    end
                end

                if usedAnySkill and AutoSwitchWeapon then
                    switchToNextWeapon()
                    task.wait(0.3)
                end
            end
        end
        task.wait(0.2)
    end
end)

----------------------------------------------------
-- MAIN AUTOFARM & LOCK-ON LOOP
----------------------------------------------------

task.spawn(function()
    while true do
        task.wait(0.02)

        local char = LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)

        if hrp then
            -- Anti Void Protection
            if AntiVoidEnabled then
                local voidHeight = (workspace.FallenPartsDestroyHeight or -500) + 50
                if hrp.Position.Y < voidHeight then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    hrp.CFrame = hrp.CFrame + Vector3.new(0, 200, 0)
                end
            end

            -- Priority Lock-on & Room Progression
            if AutoFarmDungeon then
                local target, targetType = getTargetByPriority()

                if target and not IsDodging then
                    local targetPart = getTargetPart(target)

                    if targetPart then
                        -- Skill Velocity Auto Dodge Check
                        if checkForIncomingSkill(target) then
                            IsDodging = true
                            task.spawn(function()
                                local dodgeOffset = Vector3.zero
                                if DodgeMode == "Up" then
                                    dodgeOffset = Vector3.new(0, VerticalDodgeDistance, 0)
                                elseif DodgeMode == "Away" then
                                    dodgeOffset = (hrp.CFrame.LookVector * -AutoDodgeDistance)
                                elseif DodgeMode == "Up + Away" then
                                    dodgeOffset = (hrp.CFrame.LookVector * -AutoDodgeDistance) + Vector3.new(0, VerticalDodgeDistance, 0)
                                end

                                hrp.CFrame = hrp.CFrame + dodgeOffset
                                task.wait(DodgeWait)
                                IsDodging = false
                            end)
                        else
                            -- Target Lock & Position Calculation
                            local hDist = (targetType == "Boss") and BossDistance or NormalDistance
                            local targetCFrame = targetPart.CFrame
                            local finalCFrame

                            if FarmPosition == "Orbit" then
                                OrbitAngle = (OrbitAngle + 3) % 360
                                local rad = math.rad(OrbitAngle)
                                local offset = Vector3.new(math.cos(rad) * hDist, VerticalDistance, math.sin(rad) * hDist)
                                finalCFrame = CFrame.new(targetCFrame.Position + offset, targetCFrame.Position)
                            elseif FarmPosition == "Above" then
                                finalCFrame = CFrame.new(targetCFrame.Position + Vector3.new(0, VerticalDistance + hDist, 0), targetCFrame.Position)
                            elseif FarmPosition == "Under" then
                                finalCFrame = CFrame.new(targetCFrame.Position - Vector3.new(0, VerticalDistance + hDist, 0), targetCFrame.Position)
                            end

                            -- FIX 4: Physics Engine Resistance Fix (Zero linear & angular momentum)
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            hrp.CFrame = finalCFrame
                        end
                    end
                elseif AutoNextRound and not target and not IsDodging then
                    -- Teleport to next round respawn point when room is clear
                    local respawnFolder = workspace:FindFirstChild("PlayerRespawn")
                    if respawnFolder then
                        local rounds = respawnFolder:GetChildren()
                        if #rounds > 0 then
                            local latestRound = rounds[#rounds]
                            local spawnPart = latestRound:IsA("BasePart") and latestRound or latestRound:FindFirstChildWhichIsA("BasePart", true)
                            if spawnPart then
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                hrp.AssemblyAngularVelocity = Vector3.zero
                                hrp.CFrame = spawnPart.CFrame * CFrame.new(0, 3, 0)
                            end
                        end
                    end
                end
            end
        end
    end
end)
