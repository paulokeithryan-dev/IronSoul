-- HELPER FUNCTIONS: TARGET DISCOVERY & DETECT
----------------------------------------------------

local function getTargetPart(target)
    if not target then return nil end
    if target:IsA("Model") then
        return target.PrimaryPart 
            or target:FindFirstChild("HumanoidRootPart") 
            or target:FindFirstChild("Root")
            or target:FindFirstChild("Torso") 
            or target:FindFirstChild("UpperTorso") 
            or target:FindFirstChildWhichIsA("BasePart", true)
    elseif target:IsA("BasePart") then
        return target
    end
    return nil
end

local function isAlive(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if hum then
        return hum.Health > 0
    end
    local part = getTargetPart(model)
    return part ~= nil
end

local function isBoss(npc)
    if not npc then return false end
    local hrp = getTargetPart(npc)
    if not hrp then return false end
    
    local localEnemy = hrp:FindFirstChild("LocalEnemyNpc") or npc:FindFirstChild("LocalEnemyNpc")
    if localEnemy then
        if localEnemy:IsA("ValueBase") and tostring(localEnemy.Value):lower():find("boss") then
            return true
        end
    end

    if npc.Name:lower():find("boss") then return true end

    local hum = npc:FindFirstChildOfClass("Humanoid")
    if hum and hum.MaxHealth > 5000 then return true end

    return false
end

local function getEnemies()
    local bosses, normals = {}, {}
    local enemyFolder = workspace:FindFirstChild("EnemyNpc") 
        or workspace:FindFirstChild("Enemies") 
        or workspace:FindFirstChild("Mobs") 
        or workspace:FindFirstChild("Monsters") 
        or workspace:FindFirstChild("Live")

    if enemyFolder then
        for _, npc in ipairs(enemyFolder:GetChildren()) do
            if isAlive(npc) then
                if isBoss(npc) then
                    table.insert(bosses, npc)
                else
                    table.insert(normals, npc)
                end
            end
        end
    end
    return bosses, normals
end

local function getDragonEggs()
    local eggs = {}
    local f1 = workspace:FindFirstChild("DragonEgg")
    local f2 = workspace:FindFirstChild("DragonEggs")
    
    local function collect(folder)
        if folder then
            if folder:IsA("Model") or folder:IsA("BasePart") then
                table.insert(eggs, folder)
            else
                for _, obj in ipairs(folder:GetChildren()) do
                    if isAlive(obj) or obj:IsA("BasePart") then
                        table.insert(eggs, obj)
                    end
                end
            end
        end
    end

    collect(f1)
    collect(f2)
    return eggs
end

local function getTreasureChests()
    local chests = {}
    local tFolder = workspace:FindFirstChild("TreasureChests")
    if tFolder then
        for _, round in ipairs(tFolder:GetChildren()) do
            for _, chest in ipairs(round:GetChildren()) do
                if chest:IsA("Model") or chest:IsA("BasePart") then
                    table.insert(chests, chest)
                end
            end
        end
    end
    return chests
end

-- PRIORITY LOCK-ON WITHIN DETECTION RANGE
local function getTargetByPriority()
    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    if not hrp then return nil, nil end

    local playerPos = hrp.Position
    local bosses, normals = getEnemies()
    local eggs = getDragonEggs()
    local chests = getTreasureChests()

    local function getClosestWithinRange(list)
        local closestObj = nil
        local closestDist = TargetDetectionRange

        for _, obj in ipairs(list) do
            local p = getTargetPart(obj)
            if p then
                local dist = (p.Position - playerPos).Magnitude
                if dist <= TargetDetectionRange and dist < closestDist then
                    closestObj = obj
                    closestDist = dist
                end
            end
        end

        return closestObj
    end

    for i = 1, 4 do
        local pType = Priority[i]
        if pType == "Boss" and #bosses > 0 then
            local target = getClosestWithinRange(bosses)
            if target then return target, "Boss" end
        elseif pType == "Normal Enemy NPC" and #normals > 0 then
            local target = getClosestWithinRange(normals)
            if target then return target, "Normal" end
        elseif pType == "Dragon Egg" and AutoDragonEgg and #eggs > 0 then
            local target = getClosestWithinRange(eggs)
            if target then return target, "Egg" end
        elseif pType == "Treasure Chest" and AutoTreasureChest and #chests > 0 then
            local target = getClosestWithinRange(chests)
            if target then return target, "Chest" end
        end
    end

    return nil, nil
end

-- SCAN WORKSPACE.ENEMYNPC REGARDLESS OF DISTANCE (FALLBACK BEFORE NEXT ROOM TP)
local function getGlobalEnemy()
    local bosses, normals = getEnemies()
    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    local playerPos = hrp and hrp.Position or Vector3.zero

    local closestEnemy = nil
    local closestDist = math.huge

    local function checkList(list)
        for _, npc in ipairs(list) do
            local p = getTargetPart(npc)
            if p then
                local dist = (p.Position - playerPos).Magnitude
                if dist < closestDist then
                    closestEnemy = npc
                    closestDist = dist
                end
            end
        end
    end

    checkList(bosses)
    checkList(normals)

    return closestEnemy
end

-- MASTER TARGET SELECTOR (5000 STUDS PRIORITY -> GLOBAL ENEMY SCAN -> NIL)
local function getActiveTarget()
    if not AutoFarmDungeon then return nil, nil end

    -- 1. Try finding target by priority within range
    local target, targetType = getTargetByPriority()
    if target then
        return target, targetType
    end

    -- 2. Fallback: Scan entire workspace.EnemyNpc for ANY enemy before room progression
    local globalEnemy = getGlobalEnemy()
    if globalEnemy then
        local enemyType = isBoss(globalEnemy) and "Boss" or "Normal"
        return globalEnemy, enemyType
    end

    return nil, nil
end

local function checkForIncomingSkill(target)
    if not AutoDodge or not target then return false end
    local targetPart = getTargetPart(target)
    if targetPart and targetPart:FindFirstChild("SkillVelocity") then
        return true
    end
    return false
end

-- PROXIMITY PROMPT TRIGGER (FIRED WHEN CLOSE/ORBITING)
local function handlePromptInteraction(target)
    if not target then return end

    local prompt = target:FindFirstChildOfClass("ProximityPrompt")
        or target:FindFirstChild("Interact_ProximityPrompt", true) 
        or target:FindFirstChildWhichIsA("ProximityPrompt", true)

    if prompt and prompt.Enabled then
        if fireproximityprompt then
            fireproximityprompt(prompt, 0)
        else
            prompt.HoldDuration = 0
            prompt:InputHoldBegin()
            task.wait(0.01)
            prompt:InputHoldEnd()
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            task.wait(0.01)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end
    end
end

----------------------------------------------------
-- HELPER FUNCTIONS: PROGRESSION & BACKUP PORTALS
----------------------------------------------------

local function getProgressionLocations()
    local locations = {}

    -- 1. Standard Round Spawns (PlayerRespawn.Round1 - Round9)
    local pRespawn = workspace:FindFirstChild("PlayerRespawn")
    if pRespawn then
        for i = 1, 9 do
            local roundObj = pRespawn:FindFirstChild("Round" .. tostring(i))
            if roundObj then
                local part = roundObj:IsA("BasePart") and roundObj or roundObj:FindFirstChildWhichIsA("BasePart", true)
                if part then table.insert(locations, part) end
            end
        end
    end

    -- 2. Backup Doors: workspace.RoundDoor:GetChildren()
    local roundDoor = workspace:FindFirstChild("RoundDoor")
    if roundDoor then
        for _, child in ipairs(roundDoor:GetChildren()) do
            if child.Name ~= "Portal" then
                local root = child:FindFirstChild("Root") or (child:IsA("BasePart") and child)
                if root then
                    table.insert(locations, root)
                end
            end
        end

        -- 3. Backup Portals: workspace.RoundDoor.Portal.Root.Safe
        local portal = roundDoor:FindFirstChild("Portal")
        if portal then
            local portalRoot = portal:FindFirstChild("Root")
            if portalRoot then
                local safePart = portalRoot:FindFirstChild("Safe") or (portalRoot:IsA("BasePart") and portalRoot)
                if safePart then
                    table.insert(locations, safePart)
                else
                    table.insert(locations, portalRoot)
                end
            end
        end
    end

    -- 4. Ultimate Safety Net: workspace.World (Baseplates, Island Models, Map Parts)
    local world = workspace:FindFirstChild("World")
    if world then
        for _, obj in ipairs(world:GetChildren()) do
            local part = getTargetPart(obj) or (obj:IsA("BasePart") and obj) or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then
                table.insert(locations, part)
            end
        end
    end

    return locations
end

